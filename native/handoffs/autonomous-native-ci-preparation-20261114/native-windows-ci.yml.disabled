# TASK20 INACTIVE DRAFT. This file is outside .github and ends .disabled.
# Even copying/renaming it alone cannot run the job: literal false remains.
# Root reviews helpers and fresh local gates before deliberate activation.
name: Native Windows offline CI draft
on:
  workflow_dispatch:
    inputs:
      contract_path:
        description: Absolute path of a root-reviewed per-checkout input contract
        required: true
        type: string
      contract_sha256:
        description: SHA256 of that exact reviewed contract
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: native-windows-offline-${{ github.repository }}
  cancel-in-progress: false
jobs:
  native-windows:
    if: ${{ false }}
    # Proposed disposable Windows x64 runner pool. Label is not provisioned here.
    # Exactly pinned official Go ZIP and PS7 are provisioned BEFORE offline gates.
    # No setup-go, setup-node, package manager, bootstrap or module download.
    runs-on: [self-hosted, Windows, X64, levnote-native-offline-ephemeral]
    timeout-minutes: 100
    steps:
      # Checkout/action transport is network-capable CI infrastructure, not product
      # runtime. Strong no-egress runner policies must allow only the reviewed
      # checkout/upload control plane, then block product-code egress.
      - name: Checkout reviewed source
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2, root reviews before activation
        with:
          persist-credentials: false
          clean: true
          lfs: false
          submodules: false
      - name: Run reviewed limited native gates
        shell: pwsh
        env:
          CI_CONTRACT_PATH: ${{ inputs.contract_path }}
          CI_CONTRACT_SHA256: ${{ inputs.contract_sha256 }}
          GOENV: 'off'
          GOWORK: 'off'
          GOFLAGS: '-mod=vendor'
          GOPROXY: 'off'
          GOSUMDB: 'off'
          GOVCS: '*:off'
          GOTOOLCHAIN: 'local'
          GOTELEMETRY: 'off'
          CGO_ENABLED: '0'
        run: |
          # This proposal is manual/fail-closed. No guessed empty/default contract.
          & ./native/handoffs/autonomous-native-ci-preparation-20261114/run-native-ci.ps1 -InputContractPath $env:CI_CONTRACT_PATH -InputContractSHA256 $env:CI_CONTRACT_SHA256 -ExecuteReviewed
          exit $LASTEXITCODE
      - name: Preserve limited gate evidence, including original failures
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2, root reviews before activation
        with:
          name: native-windows-evidence-${{ github.run_id }}-${{ github.run_attempt }}
          path: native/artifacts/ci/
          if-no-files-found: error
          include-hidden-files: true
          retention-days: 14
# No automatic push/PR triggers until the manual contract generation/provisioning
# policy is implemented and validated. No legacy frontend/Rust substitution.
# Real-worker opt-ins are NOT part of this base job; see REAL-WORKER-PLAN.md.
