+					current := TextInputRange{Start: 2, End: 5}
+					e.base.text, e.base.mark, e.base.marked = "original", current, tt.marked
+					e.base.trace = nil
+					handle := c.Capture()
+					resets := 0
+					reset := func(event string, expectPending bool, expectedRange TextInputRange) {
+						t.Helper()
