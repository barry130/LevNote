+		{"Replace-completion", "Replace", true, []string{"replace", "reset-replace"}, false},
+	}
+	for _, adapted := range []bool{false, true} {
+		mode := "direct"
+		if adapted {
+			mode = "installed-adapter"
+		}
+		for _, configured := range []bool{false, true} {
+			scope := "initially-unconfigured"
+			if configured {
+				scope = "configured"
