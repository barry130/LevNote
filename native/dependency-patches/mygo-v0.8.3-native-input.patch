+func TestLevNoteNativeCancelForeignTargetEndNeverAcquires(t *testing.T) {
+	for _, adapted := range []bool{false, true} {
+		mode := "direct"
+		if adapted {
+			mode = "installed-adapter"
+		}
+		for _, markless := range []bool{false, true} {
