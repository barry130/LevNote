+func TestRetiredImageAndShaderInputsDoNotRequestTextures(t *testing.T) {
+	img := scene.NewImageRGBA(1, 1, []byte{255, 0, 0, 255})
+	img.Retire()
+	f := &scene.Effect{Shader: &scene.ShaderLayout{}}
